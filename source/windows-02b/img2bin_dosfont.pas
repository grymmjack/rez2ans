procedure DrawDOSGlyph8x16Scaled(ACanvas: TCanvas; X, Y: Integer;
  const Dx: TDOSXBound; const Dy: TDOSYBound; Ch: Byte; FG, BG: TColor);

implementation

procedure DrawDOSGlyph8x16Scaled(ACanvas: TCanvas; X, Y: Integer;
  const Dx: TDOSXBound; const Dy: TDOSYBound; Ch: Byte; FG, BG: TColor);
var
  row, col, runStart: Integer;
  b: Byte;
  R: TRect;
  rx0, rx1, ry0, ry1: Integer;
begin
  if ACanvas = nil then Exit;

  // Fill background
  R := Rect(X, Y, X + Dx[8], Y + Dy[16]);
  ACanvas.Brush.Style := bsSolid;
  ACanvas.Brush.Color := BG;
  ACanvas.FillRect(R);

  // Draw glyph foreground as solid pixel runs.
  ACanvas.Brush.Color := FG;

  for row := 0 to 15 do
  begin
    b := DOSFontModernDOS8x16[Ch, row];
    col := 0;
    while col < 8 do
    begin
      // Skip 0 bits
      while (col < 8) and ((b and (1 shl (7 - col))) = 0) do Inc(col);
      if col >= 8 then Break;

      runStart := col;
      while (col < 8) and ((b and (1 shl (7 - col))) <> 0) do Inc(col);

      rx0 := X + Dx[runStart];
      rx1 := X + Dx[col];
      ry0 := Y + Dy[row];
      ry1 := Y + Dy[row + 1];

      if (rx1 > rx0) and (ry1 > ry0) then
        ACanvas.FillRect(Rect(rx0, ry0, rx1, ry1));
    end;
  end;
end;

end.
